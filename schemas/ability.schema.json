{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ability/ability.schema.json",
  "title": "Ability definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "display", "purchase", "ranks", "effect"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "$ref": "#/$defs/resource_location" },
    "display": { "$ref": "#/$defs/display" },
    "purchase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_level", "skill_points", "requirements"],
      "properties": {
        "skill_level": { "type": "integer", "minimum": 0 },
        "skill_points": { "type": "integer", "minimum": 0 },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "ranks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unlock_skill_levels", "skill_point_costs", "values"],
      "properties": {
        "unlock_skill_levels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "skill_point_costs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": { "type": ["number", "integer", "string", "boolean"] }
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "config"],
      "properties": {
        "type": { "$ref": "#/$defs/resource_location" },
        "config": { "type": "object" }
      }
    }
  },
  "$defs": {
    "resource_location": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "translation_key": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "icon", "sort_order"],
      "properties": {
        "name": { "$ref": "#/$defs/translation_key" },
        "description": { "$ref": "#/$defs/translation_key" },
        "icon": { "$ref": "#/$defs/resource_location" },
        "sort_order": { "type": "integer" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "config"],
      "properties": {
        "type": { "$ref": "#/$defs/resource_location" },
        "config": { "type": "object" }
      }
    }
  }
}
